# Server Configuration
PORT=5000

# MongoDB Database Name (defaults to herbal_garden)
MONGO_DB_NAME=herbal_garden

# MongoDB Connection String (Atlas or Local)
# Atlas SRV format:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/herbal_garden?retryWrites=true&w=majority
# Atlas Standard Replica Set format (Note: use tls=true rather than legacy ssl=true for Node 20+ compatibility):
# MONGO_URI=mongodb://<username>:<password>@<host1>:27017,<host2>:27017/?tls=true&replicaSet=<rs>&authSource=admin
# Local MongoDB format:
MONGO_URI=mongodb://127.0.0.1:27017/herbal_garden

# Session Security Secret (Use a long random string in production)
SESSION_SECRET=your_super_secret_session_key_change_in_production
NODE_ENV=development

# Google Gemini AI Integration (Phases 3-7)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
